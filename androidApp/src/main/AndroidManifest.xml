<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Сетевой статус для детектора VPN (ConnectivityManager.getActiveNetwork) -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <!-- Напоминания о занятиях: показ (API 33+) и точные будильники -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM"
        android:maxSdkVersion="32"/>
    <uses-permission android:name="android.permission.USE_EXACT_ALARM"/>

    <!-- Блокируем AD_ID пермишен, который транзитивно тянет AppMetrica SDK через
         play-services-ads-identifier. Нам не нужен рекламный идентификатор. -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID"
        tools:node="remove"/>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher_new"
        android:label="@string/app_name"
        android:name=".ScheduleApp"
        android:roundIcon="@mipmap/ic_launcher_new_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Krasava">

        <!-- Sentry: отключаем автоинициализацию через SentryInitProvider
             (краш без DSN в манифесте); SDK стартует вручную из
             AndroidDiagnostics при включённой диагностике. -->
        <meta-data
            android:name="io.sentry.auto-init"
            android:value="false"/>

        <!-- Одна иконка, без алиасов и автоадаптации: набор смены иконки
             по теме оказался хрупким (краш на старте, пропажа иконки),
             а выгода не стоила риска. -->
        <activity
            android:exported="true"
            android:windowSoftInputMode="adjustPan"
            android:name=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".notifications.LessonAlarmReceiver"
            android:exported="false"/>

        <!-- Виджет расписания (Glance): данные берёт из общего снапшота,
             который приложение пишет в SharedPreferences. -->
        <receiver
            android:name=".widget.ScheduleWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/schedule_widget_info"/>
        </receiver>

        <!-- Выбор расписания для конкретного экземпляра виджета
             (системный флоу: долгое нажатие на рабочем столе). -->
        <activity
            android:name=".widget.ScheduleWidgetConfigureActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:label="@string/widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE"/>
            </intent-filter>
        </activity>

        <!-- Применение параметров внутреннего конфигуратора после
             подтверждения закрепления из приложения: стартует
             success-callback'ом, не интерактивна. -->
        <activity
            android:name=".widget.ScheduleWidgetApplyActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.NoDisplay"/>
    </application>

</manifest>
